{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Evermap manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "system": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "summary": {
          "type": "string"
        },
        "plain": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "synced": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "init",
            "update",
            "regenerate"
          ]
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "commit",
        "mode"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/glob"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/glob"
          }
        }
      },
      "required": [
        "include"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "unmapped": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "$ref": "common.schema.json#/$defs/glob"
              },
              "reason": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "pending": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "system",
    "synced",
    "scope"
  ],
  "additionalProperties": false
}
