{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role.schema.json",
  "title": "Actor identity",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "role"
      ]
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "plain": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "parent": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "type": {
      "type": "string",
      "enum": [
        "user-role",
        "service-identity",
        "external-actor"
      ]
    },
    "lifecycle": {
      "$ref": "common.schema.json#/$defs/lifecycle"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "rationale": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidence"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/relation"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/tag"
      }
    }
  },
  "required": [
    "id",
    "kind",
    "name",
    "summary",
    "lifecycle",
    "provenance",
    "type"
  ],
  "additionalProperties": false
}
