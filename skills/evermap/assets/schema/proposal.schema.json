{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proposal.schema.json",
  "title": "Proposal overlay",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "pattern": "\\S"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "assessed",
        "accepted",
        "abandoned"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "who": {
          "type": "string",
          "pattern": "^@?[^@\\s][^@]*$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "title",
    "status"
  ],
  "additionalProperties": false
}
