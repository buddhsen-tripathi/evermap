{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "channel.schema.json",
  "title": "Asynchronous or scheduled communication",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "channel"
      ]
    },
    "name": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "summary": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "plain": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "parent": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "type": {
      "type": "string",
      "enum": [
        "queue",
        "topic",
        "outbox",
        "webhook",
        "schedule",
        "stream",
        "email"
      ]
    },
    "message": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "delivery": {
      "type": "string",
      "enum": [
        "at-least-once",
        "at-most-once",
        "exactly-once-claimed",
        "unknown"
      ]
    },
    "ordering": {
      "type": "string",
      "enum": [
        "none",
        "per-key",
        "total",
        "unknown"
      ]
    },
    "lifecycle": {
      "$ref": "common.schema.json#/$defs/lifecycle"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "rationale": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidence"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/relation"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/tag"
      }
    }
  },
  "required": [
    "id",
    "kind",
    "name",
    "summary",
    "lifecycle",
    "provenance",
    "type"
  ],
  "additionalProperties": false
}
