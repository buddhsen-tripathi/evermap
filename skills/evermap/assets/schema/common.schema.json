{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Evermap shared definitions",
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "id": {
      "type": "string",
      "pattern": "^(component|operation|entity|channel|workflow|rule|invariant|role|decision):[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*$"
    },
    "ref": {
      "type": "string",
      "pattern": "^(component|operation|entity|channel|workflow|rule|invariant|role|decision):[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*(#[A-Za-z0-9_.-]+)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)*$"
    },
    "glob": {
      "type": "string",
      "pattern": "^[^/\\\\][^\\\\]*$"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "implemented",
        "proposed",
        "deprecated"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "observed",
        "inferred",
        "stated",
        "unknown"
      ]
    },
    "sectionProvenance": {
      "type": "string",
      "enum": [
        "confirmed",
        "inferred",
        "unknown"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "code",
            "config",
            "schema",
            "test",
            "doc",
            "commit",
            "stated"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[^/\\\\][^\\\\]*$"
        },
        "symbol": {
          "type": "string",
          "pattern": "\\S"
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{16}$"
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "who": {
          "type": "string",
          "pattern": "^@?[^@\\s][^@]*$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source": {
          "type": "string",
          "pattern": "\\S"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "depends_on",
            "calls",
            "reads",
            "writes",
            "deletes",
            "publishes",
            "consumes",
            "applies",
            "uses_role"
          ]
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "mechanism": {
          "type": "string",
          "pattern": "\\S"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "message": {
          "$ref": "#/$defs/id"
        },
        "condition": {
          "type": "string",
          "pattern": "\\S"
        },
        "in_transaction": {
          "type": "string",
          "pattern": "\\S"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "type",
        "target"
      ],
      "additionalProperties": false
    },
    "param": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "type": {
          "type": "string",
          "pattern": "\\S"
        },
        "required": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "enum": [
            "path",
            "query",
            "body",
            "header",
            "message",
            "arg"
          ]
        },
        "validation": {
          "type": "string",
          "pattern": "\\S"
        },
        "maps_to": {
          "$ref": "#/$defs/ref"
        },
        "plain": {
          "type": "string",
          "pattern": "\\S"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string",
          "pattern": "\\S"
        },
        "signal": {
          "type": "string",
          "pattern": "\\S"
        },
        "plain": {
          "type": "string",
          "pattern": "\\S"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "condition",
        "signal"
      ],
      "additionalProperties": false
    }
  }
}
